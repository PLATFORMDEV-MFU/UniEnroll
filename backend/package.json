{
  "name": "unienroll-backend",
  "version": "1.0.0",
  "description": "UniEnroll API - Cloudflare Workers + Hono + D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute unienroll-db --local --file=./src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute unienroll-db --local --file=./src/db/seed.sql",
    "db:migrate:remote": "wrangler d1 execute unienroll-db --remote --file=./src/db/schema.sql",
    "db:seed:remote": "wrangler d1 execute unienroll-db --remote --file=./src/db/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.124.0"
  }
}
