{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unienroll-backend",
  "main": "src/backend/index.ts",
  "compatibility_date": "2025-02-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unienroll-d1",
      "database_id": "569a8837-b07a-4205-b275-8263b2d0186c"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_EXPLANATIONS_ENABLED": "true",
    "AI_EXPLANATION_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "STUDENT_IDENTITY_BASE_URL": "https://student-identity.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
